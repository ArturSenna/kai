{
  "name": "stremio-kai-tizen",
  "version": "1.2.0-fork.7",
  "private": true,
  "description": "ArturSenna's fork of ITzAkai/kai (Stremio Kai for Samsung Tizen TVs): Brazilian Portuguese subtitles, smart audio and subtitle track selection, styled ASS subtitles",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "package": "node tools/build.mjs && ares-package dist -o out",
    "deploy": "node tools/deploy.mjs",
    "logs": "node tools/devlog-server.mjs",
    "release": "node tools/release.mjs",
    "serve": "node tools/serve.mjs",
    "ship": "node tools/publish.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nata-sans": "^5.3.0",
    "@webos-tools/cli": "^3.2.6",
    "acorn": "^8.19.0",
    "core-js": "^3.45.0",
    "esbuild": "^0.25.0",
    "jassub": "1.8.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArturSenna/kai.git"
  },
  "packageType": "app",
  "appName": "Stremio Kai",
  "appPath": "dist/index.html",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaRewind",
    "MediaFastForward",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "ChannelUp",
    "ChannelDown"
  ],
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  },
  "serviceFile": "dist/remote-service.js"
}
